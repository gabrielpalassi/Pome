{
  "name": "pome",
  "version": "0.3.1",
  "description": "iCloud Drive for your Linux desktop.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "bin": {
    "pome": "dist/pome.js"
  },
  "scripts": {
    "bundle": "bun build ./src/pome.ts --target=bun --packages=external --minify-syntax --minify-whitespace --sourcemap=linked --outdir=dist",
    "flatpak:sources": "bun scripts/flatpak-sources.ts",
    "flatpak:install": "flatpak-builder --user --install --force-clean build-dir io.github.gabrielpalassi.Pome.local.yml",
    "flatpak:clean": "rm -rf build-dir .flatpak-builder",
    "typecheck": "bun check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "bun fmt --check .",
    "format:fix": "bun fmt .",
    "verify": "bun run typecheck && bun run lint && bun run format",
    "verify:fix": "bun run typecheck && bun run lint:fix && bun run format:fix",
    "test": "bun test --no-script"
  },
  "dependencies": {
    "dbus-next": "0.10.2",
    "puppeteer-core": "24.42.0"
  },
  "overrides": {
    "dbus-next": {
      "xml2js": "0.6.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0"
  }
}
